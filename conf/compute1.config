/*
 * Generic Compute1 LSF profile.
 *
 * The default queue is `general`. `lsf_group`, mounts, and image can be
 * provided with a params file or --lsf_* flags without editing tracked files.
 */

process {
  executor = 'lsf'
  queue = params.lsf_queue
  clusterOptions = "${params.lsf_group ? ('-G ' + params.lsf_group + ' ') : ''}-a 'docker(${params.lsf_container})' -oo ${params.run_root}/logs/nextflow_task_%J.log".trim()

  // The terminal gnomAD task uses the same configured container as the
  // workflow. Its bcftools and Python are invoked from `scomatic_env`, which
  // keeps the filter runtime reproducible and avoids assuming Python exists in
  // a bcftools-only image.
}

executor {
  pollInterval = '1 min'
  queueSize = 4
}

workDir = "${params.run_root}/work"
