/*
 * Generic Compute1 LSF profile.
 *
 * The default queue is `general`. `lsf_group`, mounts, and image can be
 * provided with a params file or --lsf_* flags without editing tracked files.
 */

def requireRunRoot = { ->
  if (!params.run_root) {
    throw new IllegalArgumentException('Set --run_root to a writable, persistent run directory.')
  }
  params.run_root
}

def lsfGroup = params.lsf_group ? " -G ${params.lsf_group}" : ''
def lsfDocker = params.lsf_container ? " -a 'docker(${params.lsf_container})'" : ''
def lsfLogs = " -oo ${requireRunRoot()}/logs/nextflow_task_%J.log"

process {
  executor = 'lsf'
  queue = params.lsf_queue
  clusterOptions = "${lsfGroup}${lsfDocker}${lsfLogs}".trim()

  withName: GNOMAD_POPMAX_FILTER {
    clusterOptions = "${lsfGroup} -a 'docker(quay.io/biocontainers/bcftools:1.21--h8b25389_0)'${lsfLogs}".trim()
  }
}

executor {
  pollInterval = '1 min'
  queueSize = 4
}

workDir = "${requireRunRoot()}/work"
