manifest {
  name = 'scomatic-v3-nextflow'
  description = 'Paired CSF/PBMC joint-BAM SComatic workflow with gnomAD common-variant filtering'
  version = '0.1.0'
  mainScript = 'main.nf'
  nextflowVersion = '>=23.10.0'
}

params {
  // Required inputs. Paths belong to the invoking Compute1 user, never to this repository.
  manifest = null
  cell_metadata = null
  reference_config = null
  scomatic_env = null
  scomatic_repo = null
  controller_runtime = null
  run_root = null

  // v3 defaults used for the published paired CSF/PBMC configuration.
  cell_types = 'B,CSF_DC,CSF_mac,CSF_mono,NK,PBMC_DC,PBMC_mac,PBMC_mono,Plasma,T,other_myeloid,progenitors'
  max_cell_types = 15
  min_base_quality = 30
  gnomad_af_cutoff = 0.001
  gnomad_release = '4.1.1'
  recovery_revision = 'v3'

  // Compute1 options. `general` is the public default; site/account-specific values are overrides.
  lsf_queue = 'general'
  lsf_group = null
  lsf_container = 'strunyadocker/mamba_minimal'
}

process {
  errorStrategy = 'terminate'
  cpus = 2
  memory = '8 GB'
  maxForks = 4

  withName: PREPARE_METADATA { cpus = 1; memory = '8 GB' }
  withName: STEP1_SPLIT { cpus = 10; memory = '20 GB' }
  withName: BUILD_JOINT_BAMS { cpus = 4; memory = '16 GB' }
  withName: STEP2_COUNTER { cpus = 10; memory = '20 GB' }
  withName: MERGE_STEP3 { cpus = 4; memory = '16 GB' }
  withName: STEP4_MAX15_POSTPROCESS { cpus = 5; memory = '20 GB' }
  withName: GNOMAD_POPMAX_FILTER { cpus = 2; memory = '8 GB'; maxForks = 1 }
}

profiles {
  local {
    process.executor = 'local'
    workDir = { "${params.run_root}/work" }
  }

  compute1 {
    includeConfig 'conf/compute1.config'
  }
}
